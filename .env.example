# Optional; scripts read these from the process environment (no .env loader).
# Port of the `bun run dev` server (default 4179) and of the Playwright e2e server (default: 4179, or a free port while it is busy).
PORT=4179
# Alternate Chromium binary for Playwright (empty = Playwright-installed Chromium).
PLAYWRIGHT_CHROMIUM_EXECUTABLE_PATH=
# JSON array of extra Chromium flags, e.g. ["--no-sandbox"] (empty = none).
PLAYWRIGHT_CHROMIUM_ARGS=
# MongoDB server for `bun run benchmark:mongodb` (default mongodb://127.0.0.1:27017); it creates and drops its own database.
MONGODB_URL=
# bun executable for the tarball check (scripts/package-tests.mjs); empty = `bun` on PATH.
BUN=
